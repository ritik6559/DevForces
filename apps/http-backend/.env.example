# http-backend (REST API) — copy to .env and fill in.
# Port
PORT=8000
NODE_ENV=development

# --- Auth / JWT ---------------------------------------------------------------
ACCESS_TOKEN_SECRET=change-me-min-32-chars
REFRESH_TOKEN_SECRET=change-me-min-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
OTP_SALT=change-me

# --- Email / OTP (Nodemailer SMTP) -------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_USER=you@example.com
SMTP_PASS=app-password

# --- Datastores ---------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@localhost:5432/devforces
REDIS_URL=redis://localhost:6379

# --- AWS S3 (workspace snapshots + tests.js fetch) ---------------------------
AWS_ACCESS_KEY=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-south-1
S3_BUCKET_NAME=devforces

# --- Orchestrator (judge) — for the submission feature -------------------
# Base URL of the orchestrator service.
ORCHESTRATOR_URL=http://localhost:8002
# Shared secret for the internal /api/judge call. MUST match the orchestrator's
# INTERNAL_API_KEY. Defaults to "devforces-internal-dev-key" if unset (dev only —
# set a real secret in production, identically on both services).
INTERNAL_API_KEY=devforces-internal-dev-key
