# runner (in-pod WebSocket IDE + PTY). Copy to .env and fill in.
# In production these are injected into the pod by kube_service.yaml; this file
# is for running the runner locally.
PORT=8001

# Workspace root inside the container (default /workspace).
WORKSPACE_ROOT=/workspace
# Allowed browser origin for the Socket.IO CORS check.
CLIENT_URL=http://localhost:5173

# --- WebSocket auth (optional, off by default) -------------------------------
# When "true", the IDE socket requires a valid token in the handshake. Leave
# unset/false unless the client passes io(url, { auth: { token } }).
RUNNER_WS_AUTH=false
# Only needed when RUNNER_WS_AUTH=true (must match http-backend ACCESS_TOKEN_SECRET).
ACCESS_TOKEN_SECRET=change-me-min-32-chars

# --- AWS S3 (diff autosave of edited files) ----------------------------------
AWS_ACCESS_KEY=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-south-1
S3_BUCKET_NAME=devforces
