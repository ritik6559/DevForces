# orchestrator (Kubernetes provisioner + judge + inactivity watcher).
# Copy to .env and fill in.
PORT=8002
NODE_ENV=development

# --- Auth ---------------------------------------------------------------------
# Used to verify the user's JWT on the heartbeat route. MUST be identical to the
# http-backend ACCESS_TOKEN_SECRET.
ACCESS_TOKEN_SECRET=change-me-min-32-chars

# --- Redis --------------------------------------------------------------
# MUST point at the SAME Redis as http-backend — the inactivity watcher reads the
# activity:* / submitting:* keys that http-backend writes. Redis >= 6.2 required.
REDIS_URL=redis://localhost:6379

# --- Internal auth ------------------------------------------------------
# Shared secret guarding POST /api/judge. MUST match http-backend INTERNAL_API_KEY.
# Defaults to "devforces-internal-dev-key" if unset (dev only — set a real secret
# in production, identically on both services).
INTERNAL_API_KEY=devforces-internal-dev-key

# Kubernetes access uses the default kubeconfig (KubeConfig.loadFromDefault()),
# not env vars. See kube.service.ts for the TLS note.
