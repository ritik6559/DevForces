generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ContestStatus {
  UPCOMING
  ACTIVE
  ENDED
}

enum ChallengeProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

enum TechStack {
  NODEJS
  PYTHON
}

model RefreshToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id])
}

model User {
  user_id    String   @id @default(uuid())
  email      String   @unique
  username   String   @unique
  role       Role     @default(USER)
  created_at DateTime @default(now())

  submissions        Submission[]
  leaderboardEntries LeaderBoard[]
  refreshTokens      RefreshToken[]
  challengeProgress  UserChallengeProgress[]
}

model Contest {
  contest_id  String        @id @default(uuid())
  title       String
  description String
  status      ContestStatus @default(UPCOMING)
  start_time  DateTime
  end_time    DateTime
  created_at  DateTime      @default(now())

  challengeMappings ContestToChallengeMapping[]
  leaderboard       LeaderBoard[]
  userProgress      UserChallengeProgress[]
}

model Challenge {
  challenge_id  String     @id @default(uuid())
  title         String
  description   String
  difficulty    Difficulty
  max_points    Int
  tech_stack    TechStack
  notion_doc_id String?

  s3_prefix String

  contestMappings ContestToChallengeMapping[]
  submissions     Submission[]
  userProgress    UserChallengeProgress[]
}

model ContestToChallengeMapping {
  id           String @id @default(uuid())
  contest_id   String
  challenge_id String
  index        Int

  contest   Contest   @relation(fields: [contest_id], references: [contest_id])
  challenge Challenge @relation(fields: [challenge_id], references: [challenge_id])

  submissions Submission[]

  @@unique([contest_id, challenge_id])
}

model UserChallengeProgress {
  id           String                  @id @default(uuid())
  user_id      String
  challenge_id String
  contest_id   String
  status       ChallengeProgressStatus @default(NOT_STARTED)

  // null until first autosave fires
  // e.g. "users/{userId}/contests/{contestId}/challenges/{challengeId}/"
  draft_s3_prefix String?

  last_saved_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user      User      @relation(fields: [user_id], references: [user_id])
  challenge Challenge @relation(fields: [challenge_id], references: [challenge_id])
  contest   Contest   @relation(fields: [contest_id], references: [contest_id])

  @@unique([user_id, challenge_id, contest_id])
}

model Submission {
  submission_id String           @id @default(uuid())
  user_id       String
  challenge_id  String
  created_at    DateTime         @default(now())
  status        SubmissionStatus @default(PENDING)

  // S3 prefix where worker snapshots submitted files before Docker runs
  submission_s3_prefix String?

  // null = practice submission (v2)
  // set  = contest submission
  contest_to_challenge_mapping_id String?

  result EvaluationResult?

  user                         User                       @relation(fields: [user_id], references: [user_id])
  challenge                    Challenge                  @relation(fields: [challenge_id], references: [challenge_id])
  contest_to_challenge_mapping ContestToChallengeMapping? @relation(fields: [contest_to_challenge_mapping_id], references: [id])
}

model EvaluationResult {
  id            String   @id @default(uuid())
  submission_id String   @unique
  created_at    DateTime @default(now())

  total_score       Int
  tests_score       Int
  static_score      Int
  tests_passed      Int
  tests_total       Int
  execution_time_ms Int

  // [{ name: string, passed: boolean, error?: string, duration_ms: number }]
  test_details Json

  llm_feedback String?

  submission Submission @relation(fields: [submission_id], references: [submission_id])
}

model LeaderBoard {
  leaderboard_id String   @id @default(uuid())
  contest_id     String
  user_id        String
  total_score    Int
  updated_at     DateTime @updatedAt

  contest Contest @relation(fields: [contest_id], references: [contest_id])
  user    User    @relation(fields: [user_id], references: [user_id])

  @@unique([contest_id, user_id])
}
