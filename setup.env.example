# ---------------------------------------------------------------------------
# DevForces infrastructure bootstrap config.
#
# Copy this file to `setup.env` and fill in real values, then run ./setup.sh
#   cp setup.env.example setup.env
#
# `setup.env` is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# AWS credentials used by the EKS workspace init containers (S3 pull) and the
# aws-credentials Kubernetes secret. Use an IAM user/role scoped to the bucket.
AWS_ACCESS_KEY_ID=XXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key

# Region and bucket the platform reads/writes workspace files from.
AWS_REGION=your-region
S3_BUCKET_NAME=your-bucket-name

# ---- Optional overrides (defaults shown; uncomment to change) --------------
# CLUSTER_CONFIG=k8s/cluster-config.yaml
# INGRESS_MANIFEST=k8s/ingress-controller.yaml
# K8S_SECRET_NAME=aws-credentials
# K8S_SECRET_NAMESPACE=default
